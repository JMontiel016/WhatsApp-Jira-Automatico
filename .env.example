# W-Ticket: PLANTILLA sin credenciales reales.
# Copiar a .env.local SOLO en tu máquina. Nunca enviar este archivo con valores.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_PROJECT_ID=
JIRA_ISSUE_TYPE_ID=
JIRA_SUBTASK_TYPE_ID=
JIRA_ASSIGNEE_ACCOUNT_ID=
JIRA_CLIENT_FIELD_ID=
JIRA_SYSTEM_FIELD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=
ENABLE_REAL_JIRA=false

# Generar una vez con: openssl rand -hex 32
WHATSAPP_LOCAL_SECRET=
WHATSAPP_AUTO_CREATE=false

# No activar Cloud API sin comprobar coexistencia oficial.
TICKETBRIDGE_CLOUD_ENABLED=false
TICKETBRIDGE_CLOUD_AUTOMATION_ENABLED=false
TICKETBRIDGE_CLOUD_COEXISTENCE_VERIFIED=false
TICKETBRIDGE_CLOUD_ROUTING_APPROVED=false
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TICKETBRIDGE_CLOUD_ADMIN_TOKEN=
